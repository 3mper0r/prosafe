# Public HTTPS origin for canonical, hreflang and og:url metadata. No path.
# On its own it does NOT make the site indexable. Rebuild after changing it.
SITE_URL=
# Search engine indexing permission. Only the exact value "enabled" allows it,
# and only together with a valid SITE_URL. Leave unset until launch approval.
SEARCH_INDEXING=

# Optional email delivery. Leave these empty to keep demo submission disabled.
QUOTE_DELIVERY_PROVIDER=
QUOTE_RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
# Exact public origin, without a trailing slash; HTTPS in production.
QUOTE_PUBLIC_ORIGIN=
# Required for submission: >=32-character random secret, shared by all
# replicas/Worker isolates. Missing or short values keep submission disabled.
QUOTE_FORM_SECRET=
