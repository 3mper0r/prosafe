# Public HTTPS origin for search metadata. Leave empty for local/staging noindex.
# Set only after launch approval; rebuild after changing it. No trailing path.
SITE_URL=

# Optional email delivery. Leave these empty to keep demo submission disabled.
QUOTE_DELIVERY_PROVIDER=
QUOTE_RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=
# Exact public origin, without a trailing slash; HTTPS in production.
QUOTE_PUBLIC_ORIGIN=
# Optional >=32-character random secret, shared by application replicas.
QUOTE_FORM_SECRET=
